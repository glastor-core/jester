  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,es",
  "allowCompoundWords": true,
  "ignorePaths": [
    ".git/**",
    "target/**",
    "Cargo.lock",
    "website/dist/**",
    "website/node_modules/**",
    "website/package-lock.json",
