---
import BaseLayout from '../layouts/BaseLayout.astro';

const initCommand = 'zerho init my-app --template react-tsx && cd my-app && zerho dev';

const pillars = [
  {
    id: 'compiler',
    label: 'Compiler & Assets',
    icon: 'bolt',
    headline: 'Native Oxc & LightningCSS pipeline, zero JS bridges.',
    summary:
      'TypeScript, JSX, CSS Modules, SVG, and WebP optimization execute directly inside one Rust binary — no Babel, PostCSS, Rollup, or sharp.',
    codeLabel: 'zerho.toml · compiler & assets',
    code: `[build]
minify = true           # oxc_minifier + mangler + DCE
scope_hoisting = true   # zero runtime module wrappers
sourcemap = "linked"

[assets]
optimize_svg = true     # pure-Rust SVG minifier
optimize_images = true  # PNG/JPG -> lossless WebP`,
    items: [
      {
        icon: 'bolt',
        title: 'Oxc Compiler, Minifier & Scope Hoisting',
        desc: 'Sub-millisecond TS/JSX transforms, lexical Scope Hoisting, AST constant folding/DCE, mangling, and Source Maps v3.',
      },
      {
        icon: 'layers',
        title: 'LightningCSS, @import & url() Rewriting',
        desc: 'Built-in CSS nesting, *.module.css scoped class maps, @import inlining, and blake3-hashed font/image asset URLs.',
      },
      {
        icon: 'image',
        title: 'Pure-Rust SVG & WebP Image Optimizer',
        desc: 'Strips SVG metadata/comments and converts PNG/JPG assets to smaller WebP automatically without Node or native C++ addons.',
      },
    ],
  },
  {
    id: 'dev',
    label: 'Dev Server & Cache',
    icon: 'speed',
    headline: 'Instant startup, React Fast Refresh & ACID redb cache.',
    summary:
      'Skip 400 MB node_modules waterfalls with in-memory Dev Partial Bundling, deep CJS-to-ESM pre-bundling, and 1.7 µs local/remote cache hits.',
    codeLabel: 'terminal · zero-node dev workflow',
    code: `$ zerho migrate              # auto-convert vite.config.*
$ zerho dev --port 5173      # HMR + /@zerho/bundle

# Open live module graph & treemap:
# -> http://127.0.0.1:5173/__inspect`,
    items: [
      {
        icon: 'speed',
        title: 'React Fast Refresh & Zero-Waterfall Dev',
        desc: 'Native oxc Fast Refresh ($RefreshReg$), /@zerho/bundle partial bundling, granular WebSocket HMR, and Shadow DOM Error Overlay.',
      },
      {
        icon: 'database',
        title: 'ACID redb B-Tree + HTTP Remote Team Cache',
        desc: 'Single-file embedded redb cache with optional HTTP remote team cache (cache.remote_url) accelerating both zerho dev and zerho build.',
      },
      {
        icon: 'hub',
        title: 'Native tsconfig Paths, CJS Pre-Bundler & Barrel Optimizer',
        desc: 'Zero-config @/* aliases, recursive multi-file CommonJS require() pre-bundling, and AST Barrel bypassing for unused exports.',
      },
    ],
  },
  {
    id: 'bundler',
    label: 'Bundler & Edge SSR',
    icon: 'call_split',
    headline: 'Parallel multi-core builds for SPAs, MPAs, Libraries & Edge.',
    summary:
      'Emit Scope-Hoisted production bundles, hashed Web Workers, streaming .wasm modules, or DOM-free Edge SSR bundles from the same graph.',
    codeLabel: 'terminal · production & edge targets',
    code: `$ zerho build --analyze      # dist/ + dist/stats.html
$ zerho build --ssr          # DOM-free dist/server.mjs
$ zerho build --watch        # incremental rebuilds
$ zerho preview --port 4173  # native Brotli .br server`,
    items: [
      {
        icon: 'call_split',
        title: 'Rayon Parallel Bundler & Shared Chunks',
        desc: 'Multi-core parallel graph builds, automatic shared chunk deduplication across dynamic import() and MPA entries, plus Brotli .br.',
      },
      {
        icon: 'memory',
        title: 'Web Workers & Streaming .wasm Imports',
        desc: 'Auto-detects new Worker(new URL(..., import.meta.url)) and .wasm imports, emitting hashed worker chunks and instantiateStreaming loaders.',
      },
      {
        icon: 'cloud',
        title: 'Edge SSR Target (--ssr) & Library Mode',
        desc: 'Emit DOM-free dist/server.mjs for Cloudflare Workers, Deno, Node, and Bun, or dual .mjs/.cjs packages via [build.lib].',
      },
    ],
  },
  {
    id: 'security',
    label: 'Security & Plugins',
    icon: 'shield',
    headline: 'Memory-safe core with built-in security & WASM isolation.',
    summary:
      'Every workspace crate enforces unsafe_code = "forbid" and clippy::pedantic, while third-party plugins run inside fuel-metered wasmtime sandboxes.',
    codeLabel: 'zerho.toml · security & wasm plugins',
    code: `[security]
sri = true             # SHA-384 integrity in HTML
csp = true             # strict dist/csp.json
secret_scan = true     # block leaked API keys

[plugins]
wasm = ["plugins/my-plugin.wasm"]
fuel_limit = 1000000   # zerho:plugin@0.1.0`,
    items: [
      {
        icon: 'shield',
        title: 'Built-in SRI, CSP, Budgets & Secret Leak Guard',
        desc: 'Native SHA-384 integrity attributes, strict dist/csp.json, Gzip/Brotli size budgets, and client-side secret scanning before ship.',
      },
      {
        icon: 'fact_check',
        title: 'zerho check, dist/stats.html & Live /__inspect Treemap',
        desc: 'Full-graph static auditor catching broken imports, cycles, and missing .env vars, paired with live interactive bundle treemaps.',
      },
      {
        icon: 'extension',
        title: 'Fuel-Metered Wasmtime Plugins (UTF-8 String ABI)',
        desc: 'Run resolve_id, load, and transform hooks inside isolated wasmtime v29 linear memory with a complete Rust -> .wasm example included.',
      },
    ],
  },
];

const crates = [
  { idx: '01', name: 'zerho-core', desc: 'Core identifiers (ModuleId, blake3 ContentHash), ModuleKind, Framework, and typed error hierarchy.' },
  { idx: '02', name: 'zerho-config', desc: 'Declarative zerho.toml parser, validator, MPA/SSR/budgets/security config, and JSON Schema generator.' },
  { idx: '03', name: 'zerho-resolver', desc: 'Native ESM/CJS & tsconfig.json paths resolution powered by oxc_resolver, package.json exports, and virtual modules.' },
  { idx: '04', name: 'zerho-graph', desc: 'Incremental module graph, DFS circular dependency detector, embedded redb cache, and HTTP remote team cache.' },
  { idx: '05', name: 'zerho-plugin', desc: 'Native Plugin trait (DefinePlugin), fuel-metered wasmtime v29 host with UTF-8 string hooks, and zerho:plugin@0.1.0 WIT.' },
  { idx: '06', name: 'zerho-transform', desc: 'Oxc TS/JSX compiler, Minifier/Mangler, Scope Hoisting, Barrel & CJS pre-bundler, Web Workers, CSS @import/url(), and SVG.' },
  { idx: '07', name: 'zerho-server', desc: 'Zero-Node axum + tokio + notify dev server, WebSocket HMR, /@zerho/bundle, /__inspect Live Treemap, and Brotli PreviewServer.' },
  { idx: '08', name: 'zerho-bundler', desc: 'Rayon parallel bundler with redb cache, Shared Chunks + modulepreload, MPA, SSR Edge target, WebP, SRI/CSP, and stats.html.' },
  { idx: '09', name: 'zerho-cli', desc: 'Single native CLI binary: dev, build (--analyze, --watch, --ssr), migrate, check (--strict), preview, bench, init, schema, and wit.' },
];
---

<BaseLayout
  title="zerho — Zero-Node, 100% Rust Frontend Dev Server & Bundler"
  description="Single 16.60 MB native Rust binary replacing Node.js in your frontend toolchain. 0.0017 ms redb cache hits, Scope Hoisting, oxc_minifier, React Fast Refresh, Web Workers, Edge SSR, and WASM plugins."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="eyebrow">
        <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">bolt</span>
        <span>v0.9.0 · Web Workers &amp; .wasm · SSR Edge Target · WASM Plugin ABI · Zero Node.js</span>
      </div>

      <h1>
        Frontend tooling at <span class="accent-text">native Rust</span> speed.
      </h1>

      <p class="hero-lead">
        <strong>zerho</strong> is a Zero-Node, 100% Rust dev server and production bundler built on
        <span class="inline-code notranslate" translate="no">oxc</span>, <span class="inline-code notranslate" translate="no">lightningcss</span>,
        <span class="inline-code notranslate" translate="no">blake3</span>, and <span class="inline-code notranslate" translate="no">wasmtime</span>.
        Ship React, Preact, Solid, and TypeScript apps with sub-millisecond transforms and zero JS runtime overhead.
      </p>

      <div class="hero-actions">
        <a href="/docs#quick-start" class="btn btn-primary">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">rocket_launch</span>
          <span>Start in 5 Seconds</span>
        </a>
        <a href="/docs" class="btn btn-secondary">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">menu_book</span>
          <span>Read the Docs</span>
        </a>
      </div>

      <div class="cli-box" role="region" aria-label="Quick start command">
        <div class="cli-code notranslate" translate="no">
          <span class="cli-prompt" aria-hidden="true">$</span>
          <code>{initCommand}</code>
        </div>
        <button type="button" class="copy-btn" data-copy={initCommand} aria-label="Copy quick start command">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
          <span data-copy-label>Copy</span>
        </button>
      </div>

      <!-- Brand / Tech inline SVG badges -->
      <div class="tech-strip" aria-label="Built with native technologies">
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="#f97316" stroke-width="2" />
            <circle cx="12" cy="12" r="3" fill="#f97316" />
          </svg>
          Rust Edition 2024
        </span>
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3" fill="#3178c6" />
            <path d="M8 10h6M11 10v7M15.5 16.5c.6.4 1.3.5 2 .5 1 0 1.6-.4 1.6-1.1 0-.7-.5-1-1.6-1.3-1.2-.3-1.8-.8-1.8-1.6 0-.9.8-1.5 1.9-1.5.7 0 1.3.2 1.7.4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          TypeScript Native
        </span>
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="2.2" fill="#61dafb" />
            <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="#61dafb" stroke-width="1.5" />
            <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="#61dafb" stroke-width="1.5" transform="rotate(60 12 12)" />
            <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="#61dafb" stroke-width="1.5" transform="rotate(120 12 12)" />
          </svg>
          React / Preact / JSX
        </span>
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 4h6a3 3 0 0 0 6 0h6v16H3V4Z" fill="#654ff0" />
            <path d="M7.5 15.5 9 10.5l1.5 5 1.5-5 1.5 5" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          WebAssembly WIT
        </span>
      </div>

      <!-- Unified KPI Bar (synced 1:1 with benchmarks/results.json) -->
      <div class="kpi-bar" aria-label="Key release benchmark metrics">
        <div class="kpi-cell">
          <div class="kpi-value">16.60 <span>MB</span></div>
          <div class="kpi-label">Single Native Binary</div>
          <div class="kpi-sub">Zero Node.js · 100% Safe Rust</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">0.0017 <span>ms</span></div>
          <div class="kpi-label">Warm redb Cache Hit</div>
          <div class="kpi-sub">1.7 µs ACID B-tree lookup · basic-ts</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">0.548 <span>ms</span></div>
          <div class="kpi-label">Cold Oxc TSX Transform</div>
          <div class="kpi-sub">0.553 ms on TypeScript entry</div>
        </div>
        <div class="kpi-cell">
          <div class="kpi-value">19.32 <span>ms</span></div>
          <div class="kpi-label">Warm Build (basic-ts · 3 mods)</div>
          <div class="kpi-sub">43.04 ms cold · 763 ms on 500 mods</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Capabilities (Interactive 4-Pillar Editorial Layout) -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">layers</span>
          <span>Core Capabilities</span>
        </span>
        <h2>Everything modern web apps need, compiled to native code.</h2>
        <p>
          No Babel, no PostCSS plugins, no Rollup glue, and no 400 MB <span class="inline-code notranslate" translate="no">node_modules</span>
          toolchain tax. Declarative <span class="inline-code notranslate" translate="no">zerho.toml</span> configuration drives the entire pipeline.
        </p>
      </div>

      <div class="pillar-tabs" role="tablist" aria-label="Zerho capability pillars">
        {pillars.map((p, idx) => (
          <button
            type="button"
            class="pillar-tab"
            role="tab"
            id={`tab-${p.id}`}
            aria-controls={`panel-${p.id}`}
            aria-selected={idx === 0 ? 'true' : 'false'}
            data-pillar-tab={p.id}
          >
            <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">{p.icon}</span>
            <span>{p.label}</span>
          </button>
        ))}
      </div>

      {pillars.map((p, idx) => (
        <div
          class="pillar-panel"
          role="tabpanel"
          id={`panel-${p.id}`}
          aria-labelledby={`tab-${p.id}`}
          data-pillar-panel={p.id}
          hidden={idx !== 0}
        >
          <div class="pillar-lead">
            <h3>{p.headline}</h3>
            <p>{p.summary}</p>
            <div class="code-block" style="margin: 0;">
              <div class="code-header">
                <span>{p.codeLabel}</span>
                <button type="button" class="copy-btn" data-copy={p.code} aria-label={`Copy ${p.label} snippet`}>
                  <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
                  <span data-copy-label>Copy</span>
                </button>
              </div>
              <pre class="notranslate" translate="no"><code set:text={p.code} /></pre>
            </div>
          </div>

          <ul class="pillar-list">
            {p.items.map((item) => (
              <li class="pillar-item">
                <span class="pillar-item-icon" aria-hidden="true">
                  <span class="material-symbols-outlined notranslate" translate="no">{item.icon}</span>
                </span>
                <div>
                  <h4>{item.title}</h4>
                  <p>{item.desc}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Real Benchmarks + Comparison Table -->
  <section class="section" id="benchmarks">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">speed</span>
          <span>Real --release Benchmarks</span>
        </span>
        <h2>Measured on real builds, not synthetic micro-loops.</h2>
        <p>
          Every number below includes exact hardware specs, cold vs. warm <span class="inline-code notranslate" translate="no">redb</span> timings,
          and a 1-command <span class="inline-code notranslate" translate="no">zerho bench --json</span> harness so any developer can verify on their own machine.
        </p>
      </div>

      <div class="bench-grid">
        <div class="bench-card">
          <div>
            <div class="bench-head">
              <h3>basic-ts (3 mods)</h3>
              <span class="bench-badge">Scope Hoisted</span>
            </div>
            <p>TypeScript + CSS, Scope Hoisting, oxc_minifier, Brotli .br (458 B), SHA-384 SRI &amp; CSP.</p>
          </div>
          <div class="bench-metrics">
            <div class="bench-metric">
              <strong>0.553 ms</strong>
              <span>Cold Oxc</span>
            </div>
            <div class="bench-metric">
              <strong>1.7 µs</strong>
              <span>redb Hit</span>
            </div>
            <div class="bench-metric">
              <strong>19.32 ms</strong>
              <span>Warm Min</span>
            </div>
          </div>
        </div>

        <div class="bench-card">
          <div>
            <div class="bench-head">
              <h3>react-tsx (5 mods)</h3>
              <span class="bench-badge">Code Split</span>
            </div>
            <p>React TSX + CJS-to-ESM + dynamic import() splitting + 2 Source Maps v3 + Brotli (1.00 KB).</p>
          </div>
          <div class="bench-metrics">
            <div class="bench-metric">
              <strong>0.548 ms</strong>
              <span>Cold TSX</span>
            </div>
            <div class="bench-metric">
              <strong>2.0 µs</strong>
              <span>redb Hit</span>
            </div>
            <div class="bench-metric">
              <strong>29.18 ms</strong>
              <span>Warm Min</span>
            </div>
          </div>
        </div>

        <div class="bench-card">
          <div>
            <div class="bench-head">
              <h3>synthetic-500</h3>
              <span class="bench-badge">499 Shaken</span>
            </div>
            <p>Deterministic 500-module TS graph: rayon parallel + Scope Hoisting + oxc_minifier + Brotli (1.53 KB).</p>
          </div>
          <div class="bench-metrics">
            <div class="bench-metric">
              <strong>1,254 ms</strong>
              <span>Cold Build</span>
            </div>
            <div class="bench-metric">
              <strong>763.5 ms</strong>
              <span>Warm Min</span>
            </div>
            <div class="bench-metric">
              <strong>655/s</strong>
              <span>Mods/sec</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Compact Reference Hardware & Reproducibility Strip -->
      <div class="hw-strip">
        <div class="hw-meta">
          <strong style="color:#fff;">Verified Reference Hardware</strong> (<span class="inline-code notranslate" translate="no">benchmarks/results.json</span>) —
          AMD Zen 3 (16 threads) · Windows 11 x86_64 · <span class="inline-code notranslate" translate="no">rustc 1.96.1</span> ·
          <span class="inline-code notranslate" translate="no">zerho --release</span> (16.60 MB) ·
          <span class="inline-code notranslate" translate="no">scope_hoisting=true minify=true brotli=true sri=true</span>
        </div>
        <div class="cli-box" style="margin: 0; max-width: 100%;" role="region" aria-label="Reproduce benchmark command">
          <div class="cli-code notranslate" translate="no">
            <span class="cli-prompt" aria-hidden="true">$</span>
            <code>cargo build --release -p zerho-cli &amp;&amp; ./target/release/zerho bench --synthetic 500 --iterations 5 --json</code>
          </div>
          <button
            type="button"
            class="copy-btn"
            data-copy="cargo build --release -p zerho-cli && ./target/release/zerho bench --synthetic 500 --iterations 5 --json"
            aria-label="Copy benchmark reproduction command"
          >
            <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
            <span data-copy-label>Copy</span>
          </button>
        </div>
      </div>

      <div class="table-wrap" role="region" aria-label="Comparison between zerho and Vite 8">
        <table>
          <thead>
            <tr>
              <th>Dimension</th>
              <th class="col-zerho">zerho v0.9.0</th>
              <th>Vite 8 (Rolldown + Node.js)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Runtime Requirement</td>
              <td class="col-zerho">Zero-Node (single 16.60 MB native binary)</td>
              <td>Node.js + npm/pnpm runtime required</td>
            </tr>
            <tr>
              <td>Configuration &amp; Migration</td>
              <td class="col-zerho">Declarative <span class="inline-code notranslate" translate="no">zerho.toml</span> + JSON Schema + <span class="inline-code notranslate" translate="no">zerho migrate</span></td>
              <td>Executable <span class="inline-code notranslate" translate="no">vite.config.ts</span> evaluated in Node</td>
            </tr>
            <tr>
              <td>JS / TS / JSX &amp; CSS Engine</td>
              <td class="col-zerho">100% in-process <span class="inline-code notranslate" translate="no">oxc</span> (Fast Refresh, Minifier, Scope Hoisting) + <span class="inline-code notranslate" translate="no">lightningcss</span> + WebP/SVG</td>
              <td>N-API bridge between JS host &amp; Rust crates</td>
            </tr>
            <tr>
              <td>Persistent Transform Cache</td>
              <td class="col-zerho">ACID <span class="inline-code notranslate" translate="no">redb</span> B-tree + <span class="inline-code notranslate" translate="no">blake3</span> + HTTP Remote Team Cache (0.0017 ms warm hits)</td>
              <td>JS filesystem &amp; dep pre-bundle cache</td>
            </tr>
            <tr>
              <td>Web Platform &amp; Edge SSR</td>
              <td class="col-zerho">Web Workers, <span class="inline-code notranslate" translate="no">.wasm</span> streaming, MPA, Library Mode &amp; <span class="inline-code notranslate" translate="no">--ssr</span> Edge bundles</td>
              <td>Requires extra SSR/worker/library plugins &amp; Node config</td>
            </tr>
            <tr>
              <td>Plugin Isolation</td>
              <td class="col-zerho">Fuel-metered <span class="inline-code notranslate" translate="no">wasmtime</span> WASM (<span class="inline-code notranslate" translate="no">zerho:plugin@0.1.0</span>) + UTF-8 string hooks</td>
              <td>Full-privilege Node.js JS plugins</td>
            </tr>
            <tr>
              <td>DevTools &amp; Memory Safety</td>
              <td class="col-zerho">Built-in <span class="inline-code notranslate" translate="no">/__inspect</span> + Live Treemap, <span class="inline-code notranslate" translate="no">dist/stats.html</span> &amp; <span class="inline-code notranslate" translate="no">unsafe_code = "forbid"</span></td>
              <td>External plugin (<span class="inline-code notranslate" translate="no">vite-plugin-inspect</span>)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 9-Crate Architecture (Split Sticky Intro + Hairline Ledger) -->
  <section class="section" id="architecture">
    <div class="container arch-split">
      <div class="arch-sticky">
        <span class="eyebrow">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">hub</span>
          <span>Modular Rust Workspace</span>
        </span>
        <h2>9 focused crates. 60/60 passing tests. Pedantic clean.</h2>
        <p>
          Every layer is cleanly decoupled in a Rust Edition 2024 workspace enforced with
          <span class="inline-code notranslate" translate="no">clippy::pedantic -D warnings</span> and
          <span class="inline-code notranslate" translate="no">unsafe_code = "forbid"</span>.
        </p>
        <div class="arch-stats">
          <span class="arch-stat">Edition 2024</span>
          <span class="arch-stat">unsafe_code = "forbid"</span>
          <span class="arch-stat">60/60 tests</span>
        </div>
      </div>

      <ol class="crate-ledger" aria-label="Workspace crates">
        {crates.map((c) => (
          <li class="crate-row">
            <span class="crate-idx">{c.idx}</span>
            <span class="crate-name notranslate" translate="no">{c.name}</span>
            <span class="crate-desc">{c.desc}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <div>
          <h2>Ready to drop Node.js from your build pipeline?</h2>
          <p>Explore the full <span class="inline-code notranslate" translate="no">zerho.toml</span> reference, CLI commands, HMR API, and WASM WIT contract.</p>
        </div>
        <a href="/docs" class="btn btn-primary">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">menu_book</span>
          <span>Open Documentation</span>
        </a>
      </div>
    </div>
  </section>

  <script is:inline>
    const tabs = document.querySelectorAll('[data-pillar-tab]');
    const panels = document.querySelectorAll('[data-pillar-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-pillar-tab');
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => {
          p.hidden = p.getAttribute('data-pillar-panel') !== target;
        });
      });
    });
  </script>
</BaseLayout>
