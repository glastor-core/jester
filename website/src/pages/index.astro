  <script is:inline>
    const tabs = document.querySelectorAll('[data-pillar-tab]');
    const panels = document.querySelectorAll('[data-pillar-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-pillar-tab');
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => {
          p.hidden = p.getAttribute('data-pillar-panel') !== target;
        });
      });
    });

    const installTabs = document.querySelectorAll('[data-install-tab]');
    const installPanels = document.querySelectorAll('[data-install-panel]');
    installTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-install-tab');
        installTabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        installPanels.forEach((p) => {
          p.hidden = p.getAttribute('data-install-panel') !== target;
        });
      });
    });
  </script>
