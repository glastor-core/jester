---
import BaseLayout from '../layouts/BaseLayout.astro';

const initCommand = 'zerho init my-app --template react-tsx && cd my-app && zerho dev';

const features = [
  {
    icon: 'bolt',
    title: 'Oxc Compiler, Minifier & Scope Hoisting',
    desc: 'Sub-millisecond TS/JSX transforms, lexical Scope Hoisting (zero runtime wrappers), AST constant folding/DCE, mangling, and Source Maps v3.',
  },
  {
    icon: 'layers',
    title: 'LightningCSS, SVG & WebP Image Optimizer',
    desc: 'Built-in CSS nesting, *.module.css scoped class maps, pure-Rust SVG minification, and automatic PNG/JPG to WebP conversion without sharp or Node.',
  },
  {
    icon: 'hub',
    title: 'Native tsconfig Paths & Barrel Optimizer',
    desc: 'Zero-config @/* alias resolution via oxc_resolver plus AST Barrel File bypassing so unused re-exported modules are never loaded or parsed.',
  },
  {
    icon: 'speed',
    title: 'React Fast Refresh & Zero-Waterfall Dev',
    desc: 'Native oxc React Fast Refresh ($RefreshReg$), in-memory Dev Partial Bundling (/@zerho/bundle), granular HMR, and Shadow DOM Error Overlay.',
  },
  {
    icon: 'database',
    title: 'Acid redb Cache + Remote Team Cache',
    desc: 'Single-file embedded redb B-tree cache with HTTP remote team cache fallback (cache.remote_url) accelerating both zerho dev and zerho build.',
  },
  {
    icon: 'call_split',
    title: 'Rayon Parallel Bundler & Shared Chunks',
    desc: 'Multi-core parallel graph builds, automatic shared chunk deduplication across dynamic import(), <link rel="modulepreload">, and Brotli .br emission.',
  },
  {
    icon: 'shield',
    title: 'Built-in SRI, CSP, Budgets & Secret Guard',
    desc: 'Native SHA-384 integrity attributes, strict dist/csp.json, Gzip/Brotli bundle budgets, and client-side secret leak scanning before ship.',
  },
  {
    icon: 'fact_check',
    title: 'zerho check & dist/stats.html Analyzer',
    desc: 'Full-graph static auditor catching broken imports, circular dependencies, and missing .env vars in milliseconds, plus an interactive HTML treemap.',
  },
  {
    icon: 'extension',
    title: 'Safe Rust Binary & Wasmtime Plugins',
    desc: 'Rust Edition 2024, unsafe_code = "forbid", clippy::pedantic -D warnings, and fuel-metered WASM plugins (zerho:plugin@0.1.0 WIT).',
  },
];

const crates = [
  { name: 'zerho-core', desc: 'Core identifiers (ModuleId, blake3 ContentHash), ModuleKind, Framework, and typed error hierarchy.' },
  { name: 'zerho-config', desc: 'Declarative zerho.toml parser, validator, budgets/security/remote-cache config, and JSON Schema generator.' },
  { name: 'zerho-resolver', desc: 'Native ESM/CJS & tsconfig.json paths resolution powered by oxc_resolver, package.json exports, and virtual modules.' },
  { name: 'zerho-graph', desc: 'Incremental module graph, DFS circular dependency detector, embedded redb cache, and HTTP remote team cache.' },
  { name: 'zerho-plugin', desc: 'Native Plugin trait (DefinePlugin), fuel-metered wasmtime v29 host, and zerho:plugin@0.1.0 WIT contract.' },
  { name: 'zerho-transform', desc: 'Oxc TS/JSX compiler, Minifier/Mangler, Scope Hoisting, Barrel Optimizer, SVG optimizer, and lightningcss pipeline.' },
  { name: 'zerho-server', desc: 'Zero-Node axum + tokio + notify dev server, WebSocket HMR, /@zerho/bundle, /__inspect UI, and Brotli PreviewServer.' },
  { name: 'zerho-bundler', desc: 'Rayon parallel bundler with incremental redb cache, Shared Chunks + modulepreload, Brotli .br, SRI/CSP, zerho check, and stats.html.' },
  { name: 'zerho-cli', desc: 'Single native CLI binary: dev, build (--analyze), check (--strict), preview, bench, init, schema, and wit.' },
];
---

<BaseLayout
  title="zerho — Zero-Node, 100% Rust Frontend Dev Server & Bundler"
  description="Single 16.57 MB native Rust binary replacing Node.js in your frontend toolchain. 0.002 ms redb cache hits, Scope Hoisting, oxc_minifier, React Fast Refresh, Brotli, and Library Mode."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="eyebrow">
        <span class="material-symbols-outlined" aria-hidden="true">bolt</span>
        <span>v0.7.0 · 0.002 ms redb Cache · Scope Hoisting · React Fast Refresh · Zero Node.js</span>
      </div>

      <h1>
        Frontend tooling at <span class="accent-text">native Rust</span> speed.
      </h1>

      <p class="hero-lead">
        <strong>zerho</strong> is a Zero-Node, 100% Rust dev server and production bundler built on
        <span class="inline-code">oxc</span>, <span class="inline-code">lightningcss</span>,
        <span class="inline-code">blake3</span>, and <span class="inline-code">wasmtime</span>.
        Ship React, Preact, Solid, and TypeScript apps with sub-millisecond transforms and zero JS runtime overhead.
      </p>

      <div class="hero-actions">
        <a href="/docs#quick-start" class="btn btn-primary">
          <span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>
          <span>Start in 5 Seconds</span>
        </a>
        <a href="/docs" class="btn btn-secondary">
          <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
          <span>Read the Docs</span>
        </a>
      </div>

      <div class="cli-box" role="region" aria-label="Quick start command">
        <div class="cli-code">
          <span class="cli-prompt" aria-hidden="true">$</span>
          <code>{initCommand}</code>
        </div>
        <button type="button" class="copy-btn" data-copy={initCommand} aria-label="Copy quick start command">
          <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
          <span data-copy-label>Copy</span>
        </button>
      </div>

      <!-- Brand / Tech inline SVG badges -->
      <div class="tech-strip" aria-label="Built with native technologies">
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="9" stroke="#f97316" stroke-width="2" />
            <circle cx="12" cy="12" r="3" fill="#f97316" />
          </svg>
          Rust Edition 2024
        </span>
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="3" fill="#3178c6" />
            <path d="M8 10h6M11 10v7M15.5 16.5c.6.4 1.3.5 2 .5 1 0 1.6-.4 1.6-1.1 0-.7-.5-1-1.6-1.3-1.2-.3-1.8-.8-1.8-1.6 0-.9.8-1.5 1.9-1.5.7 0 1.3.2 1.7.4" stroke="#fff" stroke-width="1.5" stroke-linecap="round" />
          </svg>
          TypeScript Native
        </span>
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="12" r="2.2" fill="#61dafb" />
            <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="#61dafb" stroke-width="1.5" />
            <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="#61dafb" stroke-width="1.5" transform="rotate(60 12 12)" />
            <ellipse cx="12" cy="12" rx="9" ry="3.8" stroke="#61dafb" stroke-width="1.5" transform="rotate(120 12 12)" />
          </svg>
          React / Preact / Solid
        </span>
        <span class="tech-pill">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M3 4h6a3 3 0 0 0 6 0h6v16H3V4Z" fill="#654ff0" />
            <path d="M7.5 15.5 9 10.5l1.5 5 1.5-5 1.5 5" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          WebAssembly WIT
        </span>
      </div>

      <!-- KPI Benchmark Strip -->
      <div class="kpi-grid" aria-label="Key release benchmark metrics">
        <div class="kpi-card">
          <div class="kpi-value">16.57 <span>MB</span></div>
          <div class="kpi-label">Single Native Binary</div>
          <div class="kpi-sub">Zero Node.js · unsafe_code = "forbid"</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-value">0.002 <span>ms</span></div>
          <div class="kpi-label">Warm redb Cache Hit</div>
          <div class="kpi-sub">2 µs ACID B-tree lookup · --release</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-value">0.63 <span>ms</span></div>
          <div class="kpi-label">Cold Oxc TSX Transform</div>
          <div class="kpi-sub">0.73 ms on TypeScript entry</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-value">17.06 <span>ms</span></div>
          <div class="kpi-label">Full v0.7 Production Build</div>
          <div class="kpi-sub">Scope Hoisting + Minifier + Brotli + SRI</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature Grid -->
  <section class="section" id="features">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">layers</span>
          <span>Core Capabilities</span>
        </span>
        <h2>Everything modern web apps need, compiled to native code.</h2>
        <p>
          No Babel, no PostCSS plugins, no Rollup glue, and no 400 MB <span class="inline-code">node_modules</span>
          toolchain tax. Declarative <span class="inline-code">zerho.toml</span> configuration drives the entire pipeline.
        </p>
      </div>

      <div class="feature-grid">
        {features.map((f) => (
          <article class="card">
            <div class="card-icon">
              <span class="material-symbols-outlined" aria-hidden="true">{f.icon}</span>
            </div>
            <h3>{f.title}</h3>
            <p>{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Real Benchmarks + Comparison Table -->
  <section class="section" id="benchmarks">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">speed</span>
          <span>Real --release Benchmarks</span>
        </span>
        <h2>Measured on real builds, not synthetic micro-loops.</h2>
        <p>
          Reproducible via <span class="inline-code">zerho bench --iterations 20</span> on Windows
          using the compiled v0.7.0 <span class="inline-code">--release</span> binary (16.57 MB) with
          Scope Hoisting, <span class="inline-code">oxc_minifier</span>, Brotli <span class="inline-code">.br</span>, and SHA-384 SRI enabled.
        </p>
      </div>

      <div class="bench-grid">
        <div class="bench-card">
          <div class="bench-head">
            <h3>basic-ts</h3>
            <span class="bench-badge">20 iterations · v0.7.0 --release</span>
          </div>
          <p>TypeScript entry + CSS bundling, Scope Hoisting, oxc_minifier, Brotli .br, SHA-384 SRI, and CSP manifest.</p>
          <div class="bench-metrics">
            <div class="bench-metric">
              <strong>0.73 ms</strong>
              <span>Cold Oxc Transform</span>
            </div>
            <div class="bench-metric">
              <strong>0.002 ms</strong>
              <span>Warm redb Cache (2 µs)</span>
            </div>
            <div class="bench-metric">
              <strong>17.06 ms</strong>
              <span>Min Build (19.96 ms avg)</span>
            </div>
          </div>
        </div>

        <div class="bench-card">
          <div class="bench-head">
            <h3>react-tsx-demo</h3>
            <span class="bench-badge">20 iterations · v0.7.0 --release</span>
          </div>
          <p>5 modules + CJS-to-ESM + dynamic import() splitting + 2 Source Maps v3 + Scope Hoisting + Brotli .br.</p>
          <div class="bench-metrics">
            <div class="bench-metric">
              <strong>0.63 ms</strong>
              <span>Cold TSX Transform</span>
            </div>
            <div class="bench-metric">
              <strong>0.002 ms</strong>
              <span>Warm redb Cache (2 µs)</span>
            </div>
            <div class="bench-metric">
              <strong>29.76 ms</strong>
              <span>Min Build (35.16 ms avg)</span>
            </div>
          </div>
        </div>
      </div>

      <div class="table-wrap" role="region" aria-label="Comparison between zerho and Vite 8">
        <table>
          <thead>
            <tr>
              <th>Dimension</th>
              <th class="col-zerho">zerho v0.1.0</th>
              <th>Vite 8 (Rolldown + Node.js)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Runtime Requirement</td>
              <td class="col-zerho">Zero-Node (single 12.65 MB native binary)</td>
              <td>Node.js + npm/pnpm runtime required</td>
            </tr>
            <tr>
              <td>Configuration</td>
              <td class="col-zerho">Declarative <span class="inline-code">zerho.toml</span> + JSON Schema</td>
              <td>Executable <span class="inline-code">vite.config.ts</span> evaluated in Node</td>
            </tr>
            <tr>
              <td>JS / TS / JSX &amp; CSS Engine</td>
              <td class="col-zerho">100% in-process <span class="inline-code">oxc</span> + <span class="inline-code">lightningcss</span></td>
              <td>N-API bridge between JS host &amp; Rust crates</td>
            </tr>
            <tr>
              <td>Persistent Transform Cache</td>
              <td class="col-zerho">Native <span class="inline-code">blake3</span> disk cache (0.232 ms hits)</td>
              <td>JS filesystem &amp; dep pre-bundle cache</td>
            </tr>
            <tr>
              <td>Plugin Isolation</td>
              <td class="col-zerho">Fuel-metered <span class="inline-code">wasmtime</span> WASM (<span class="inline-code">zerho:plugin@0.1.0</span>)</td>
              <td>Full-privilege Node.js JS plugins</td>
            </tr>
            <tr>
              <td>DevTools &amp; Memory Safety</td>
              <td class="col-zerho">Built-in <span class="inline-code">/__inspect</span> UI · <span class="inline-code">unsafe_code = "forbid"</span></td>
              <td>External plugin (<span class="inline-code">vite-plugin-inspect</span>)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 9-Crate Architecture -->
  <section class="section" id="architecture">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow">
          <span class="material-symbols-outlined" aria-hidden="true">hub</span>
          <span>Modular Rust Workspace</span>
        </span>
        <h2>9 focused crates. 30/30 passing tests. Pedantic clean.</h2>
        <p>
          Every layer is cleanly decoupled in a Rust Edition 2024 workspace enforced with
          <span class="inline-code">clippy::pedantic -D warnings</span> and
          <span class="inline-code">unsafe_code = "forbid"</span>.
        </p>
      </div>

      <div class="crate-grid">
        {crates.map((c) => (
          <div class="crate-card">
            <div class="crate-name">{c.name}</div>
            <p>{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="container">
      <div class="cta-banner">
        <div>
          <h2>Ready to drop Node.js from your build pipeline?</h2>
          <p>Explore the full <span class="inline-code">zerho.toml</span> reference, CLI commands, HMR API, and WASM WIT contract.</p>
        </div>
        <a href="/docs" class="btn btn-primary">
          <span class="material-symbols-outlined" aria-hidden="true">menu_book</span>
          <span>Open Documentation</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
