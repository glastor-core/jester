---
import BaseLayout from '../layouts/BaseLayout.astro';

const quickStartCode = `# Scaffold a React + TypeScript project in milliseconds
zerho init my-app --template react-tsx
cd my-app

# Start the Zero-Node dev server (HMR + /@zerho/bundle + /__inspect)
zerho dev

# Audit the full module graph (broken imports, cycles, missing .env, secrets)
zerho check

# Build scope-hoisted, minified, Brotli-compressed bundle + dist/stats.html
zerho build --analyze

# Preview the production dist/ output locally (serves .br automatically)
zerho preview --port 4173`;

const tomlReference = `[project]
name = "my-app"
root = "."
entry = "src/main.tsx"
public_dir = "public"
env_prefix = "ZERHO_"
framework = "react"          # react | preact | vanilla (solid uses classic JSX pragma)

[server]
host = "127.0.0.1"
port = 5173
hmr = true
open = false
partial_bundling = true      # zero-waterfall /@zerho/bundle in dev

[server.proxy]
"/api" = "http://127.0.0.1:8080"

[build]
out_dir = "dist"
minify = true                # oxc_minifier constant folding + DCE + mangling
sourcemap = "linked"         # none | linked | inline | hidden
target = "es2022"
splitting = true             # dynamic import() + shared chunks + modulepreload
brotli = true                # emit .br pre-compressed assets
scope_hoisting = true        # flatten acyclic ESM without runtime wrappers
analyze = false              # emit dist/stats.html interactive treemap
ssr = false                  # emit DOM-free dist/server.mjs for Edge/SSR

# [build.entries]            # Multi-Page App (MPA) script entry points
# index = "src/main.ts"
# admin = "src/admin.ts"

[build.budgets]
max_js_kb = 150
max_css_kb = 40
max_chunk_kb = 100

[css]
modules = true               # native *.module.css via lightningcss
minify = true

[cache]
enabled = true
dir = ".zerho/cache"         # embedded ACID redb B-tree cache
# remote_url = "http://127.0.0.1:9000/cache"
# remote_token = "env:ZERHO_CACHE_TOKEN"

[security]
sri = true                   # SHA-384 integrity in index.html & manifest.json
csp = true                   # emit strict dist/csp.json
secret_scan = true           # fail build on leaked API keys / private keys

[assets]
optimize_svg = true          # pure-Rust SVG minification
optimize_images = true       # pure-Rust PNG/JPG -> WebP conversion

[plugins]
# wasm = ["plugins/my-plugin.wasm"]  # sandboxed wasmtime plugins
# fuel_limit = 1000000

[build.lib]
# entry = "src/index.ts"     # enables Library Mode (.mjs + .cjs)
# name = "my-lib"
# formats = ["es", "cjs"]`;

const hmrSnippet = `// Granular state-preserving HMR in any module
let count = import.meta.hot?.data.count ?? 0;

if (import.meta.hot) {
  import.meta.hot.dispose((data) => {
    data.count = count;
  });

  import.meta.hot.accept((nextMod) => {
    // Hot-swap without losing component or module state
    console.log('HMR updated:', nextMod);
  });
}`;

const cssAssetsSnippet = `// Scoped CSS Modules powered natively by lightningcss
import styles from './Button.module.css';

// Static asset imports (?import in dev, blake3-hashed emission in prod)
import logoUrl from './assets/logo.svg';

export function Header() {
  return (
    <header className={styles.bar}>
      <img src={logoUrl} alt="zerho" width="32" height="32" />
    </header>
  );
}`;

const envSnippet = `# .env (only keys matching project.env_prefix are exposed to client code)
ZERHO_API_URL=https://api.example.com
SECRET_DB_PASSWORD=never-exposed-to-browser

# In TypeScript:
const apiUrl = import.meta.env.ZERHO_API_URL;
const mode   = import.meta.env.MODE; // "development" | "production"`;

const witContract = `package zerho:plugin@0.1.0;

interface types {
    enum module-kind {
        js,
        ts,
        jsx,
        tsx,
        css,
        json,
        asset,
        virtual-mod,
    }

    record plugin-context {
        is-dev: bool,
    }

    record transform-result {
        code: string,
        sourcemap: option<string>,
    }
}

interface hooks {
    use types.{module-kind, plugin-context, transform-result};

    name: func() -> string;
    resolve-id: func(specifier: string, importer: option<string>) -> result<option<string>, string>;
    load: func(id: string, ctx: plugin-context) -> result<option<string>, string>;
    transform: func(
        code: string,
        id: string,
        kind: module-kind,
        ctx: plugin-context,
    ) -> result<option<transform-result>, string>;
}

world zerho-plugin {
    export hooks;
}`;

const cliCommands = [
  { cmd: 'zerho init [DIR] --template <NAME>', desc: 'Scaffold a Zero-Node project (basic-ts | react-tsx).' },
  { cmd: 'zerho migrate [DIR] [--dry-run] [--force]', desc: 'Inspect package.json, vite.config.*, index.html, and tsconfig.json to generate a ready-to-run zerho.toml.' },
  { cmd: 'zerho dev [--config PATH] [--port PORT]', desc: 'Start the axum + tokio dev server with WebSocket HMR, /@zerho/bundle, /@zerho/deps, and /__inspect UI.' },
  { cmd: 'zerho build [--config PATH] [--analyze] [--watch] [--ssr]', desc: 'Parallel rayon build with Scope Hoisting, oxc_minifier, redb cache, Web Workers/.wasm, Shared Chunks + modulepreload, Brotli .br, SRI/CSP, SSR Edge mode, and optional dist/stats.html.' },
  { cmd: 'zerho check [--config PATH] [--strict]', desc: 'Audit the full module graph in milliseconds for broken imports, circular dependencies, missing .env vars, and leaked secrets.' },
  { cmd: 'zerho preview [--config PATH] [--port PORT]', desc: 'Serve the production dist/ directory locally with automatic Accept-Encoding: br negotiation.' },
  { cmd: 'zerho test [FILTER] [--config PATH]', desc: 'Run *.test.{ts,tsx,js,jsx} and *.spec.* suites natively with oxc (describe/test/it/expect) without Vitest or Node.js.' },
  { cmd: 'zerho cache-server [--host H] [--port P] [--dir DIR] [--token TOK]', desc: 'Start the pure-Rust HTTP CAS remote team cache daemon compatible with [cache].remote_url.' },
  { cmd: 'zerho bench [--config PATH] [--iterations N] [--synthetic N] [--json]', desc: 'Run reproducible cold Oxc transform, warm redb cache, and full/synthetic N-module build benchmarks with optional JSON telemetry.' },
  { cmd: 'zerho schema', desc: 'Print the complete JSON Schema for zerho.toml for IDE validation and autocompletion.' },
  { cmd: 'zerho wit', desc: 'Print the canonical zerho:plugin@0.1.0 WebAssembly Component Model WIT contract.' },
];
---

<BaseLayout
  title="Documentation — zerho v1.0.0"
  description="Complete documentation for zerho v1.0.0: Quick Start, zerho.toml configuration reference, CLI commands (dev, build --analyze --watch --ssr, migrate, check, preview, bench), Web Workers, .wasm imports, React Fast Refresh, Library Mode, WebP optimization, and WASM WIT plugins."
>
  <div class="container docs-layout">
    <aside class="docs-sidebar" aria-label="Documentation sections">
      <div class="docs-sidebar-title">On This Page</div>
      <ul class="docs-nav">
        <li><a href="#quick-start">Quick Start</a></li>
        <li><a href="#zerho-toml">zerho.toml Reference</a></li>
        <li><a href="#cli">CLI Commands</a></li>
        <li><a href="#hmr-overlay">HMR &amp; Error Overlay</a></li>
        <li><a href="#css-assets">CSS Modules &amp; Assets</a></li>
        <li><a href="#env-proxy">.env &amp; HTTP Proxy</a></li>
        <li><a href="#wasm-wit">WASM Plugin WIT Contract</a></li>
        <li><a href="#devsecops">DevSecOps &amp; Supply Chain</a></li>
      </ul>
    </aside>

    <article class="docs-content">
      <section id="quick-start">
        <div class="eyebrow" style="margin-bottom: 14px;">
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">menu_book</span>
          <span>Documentation · v1.0.0</span>
        </div>
        <h1>zerho Documentation</h1>
        <p>
          Everything you need to configure, run, benchmark, and extend <strong>zerho</strong> —
          the Zero-Node, 100% Rust frontend dev server and production bundler.
        </p>

        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">rocket_launch</span>
          Quick Start
        </h2>
        <p>
          Create a new project using <span class="inline-code notranslate" translate="no">zerho init</span> with either the
          <span class="inline-code notranslate" translate="no">basic-ts</span> or <span class="inline-code notranslate" translate="no">react-tsx</span> template:
        </p>
        <div class="code-block">
          <div class="code-header">
            <span>bash</span>
            <button type="button" class="copy-btn" data-copy={quickStartCode} aria-label="Copy quick start commands">
              <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre class="notranslate" translate="no"><code set:text={quickStartCode} /></pre>
        </div>
        <p>
          Once <span class="inline-code notranslate" translate="no">zerho dev</span> is running, open
          <span class="inline-code notranslate" translate="no">http://127.0.0.1:5173/__inspect</span> to inspect the live
          module graph, dependency edges, and <span class="inline-code notranslate" translate="no">blake3</span> disk cache hits.
        </p>
      </section>

      <section id="zerho-toml">
        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">tune</span>
          zerho.toml Full Reference
        </h2>
        <p>
          All configuration is declarative and validated at startup by <span class="inline-code notranslate" translate="no">zerho-config</span>.
          Run <span class="inline-code notranslate" translate="no">zerho schema</span> to generate the official JSON Schema for editor tooling.
        </p>
        <div class="code-block">
          <div class="code-header">
            <span>zerho.toml</span>
            <button type="button" class="copy-btn" data-copy={tomlReference} aria-label="Copy zerho.toml reference">
              <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre class="notranslate" translate="no"><code set:text={tomlReference} /></pre>
        </div>
      </section>

      <section id="cli">
        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">terminal</span>
          CLI Commands
        </h2>
        <p>
          All commands ship inside the single 16.60 MB <span class="inline-code notranslate" translate="no">zerho</span> binary.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Command</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              {cliCommands.map((item) => (
                <tr>
                  <td><span class="inline-code notranslate" translate="no">{item.cmd}</span></td>
                  <td>{item.desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      <section id="hmr-overlay">
        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">speed</span>
          Granular HMR &amp; Shadow DOM Error Overlay
        </h2>
        <p>
          <span class="inline-code notranslate" translate="no">zerho-server</span> injects the native <span class="inline-code notranslate" translate="no">/@zerho/client</span>
          WebSocket runtime and walks reverse edges in <span class="inline-code notranslate" translate="no">zerho-graph</span> to invalidate only
          affected modules. State persists across edits via <span class="inline-code notranslate" translate="no">import.meta.hot.data</span>.
        </p>
        <div class="code-block">
          <div class="code-header">
            <span>src/counter.ts</span>
            <button type="button" class="copy-btn" data-copy={hmrSnippet} aria-label="Copy HMR example">
              <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre class="notranslate" translate="no"><code set:text={hmrSnippet} /></pre>
        </div>
        <ul>
          <li><strong>Shadow DOM Isolation:</strong> Compile errors from <span class="inline-code notranslate" translate="no">oxc</span> or <span class="inline-code notranslate" translate="no">lightningcss</span> render inside <span class="inline-code notranslate" translate="no">&lt;zerho-error-overlay&gt;</span> without leaking app CSS.</li>
          <li><strong>Auto-Dismiss:</strong> Saving a valid fix clears the overlay automatically over WebSocket without a full page reload.</li>
        </ul>
      </section>

      <section id="css-assets">
        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">layers</span>
          CSS Modules &amp; Static Asset Imports
        </h2>
        <p>
          Files ending in <span class="inline-code notranslate" translate="no">.module.css</span> are compiled by <span class="inline-code notranslate" translate="no">lightningcss</span>
          into scoped class maps. Static assets (SVG, PNG, WebP, fonts) resolve via <span class="inline-code notranslate" translate="no">?import</span> in dev
          and emit <span class="inline-code notranslate" translate="no">blake3</span>-hashed filenames in production builds.
        </p>
        <div class="code-block">
          <div class="code-header">
            <span>src/Header.tsx</span>
            <button type="button" class="copy-btn" data-copy={cssAssetsSnippet} aria-label="Copy CSS Modules and asset example">
              <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre class="notranslate" translate="no"><code set:text={cssAssetsSnippet} /></pre>
        </div>
      </section>

      <section id="env-proxy">
        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">shield</span>
          .env &amp; [server.proxy]
        </h2>
        <p>
          Environment variables loaded from <span class="inline-code notranslate" translate="no">.env</span> are strictly filtered by
          <span class="inline-code notranslate" translate="no">project.env_prefix</span> (default: <span class="inline-code notranslate" translate="no">ZERHO_</span>)
          before compile-time injection via <span class="inline-code notranslate" translate="no">DefinePlugin</span>.
        </p>
        <div class="code-block">
          <div class="code-header">
            <span>.env &amp; client usage</span>
            <button type="button" class="copy-btn" data-copy={envSnippet} aria-label="Copy env example">
              <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre class="notranslate" translate="no"><code set:text={envSnippet} /></pre>
        </div>
        <p>
          To forward API requests during local development without CORS friction, map path prefixes under
          <span class="inline-code notranslate" translate="no">[server.proxy]</span> in <span class="inline-code notranslate" translate="no">zerho.toml</span>
          (for example <span class="inline-code notranslate" translate="no">"/api" = "http://127.0.0.1:8080"</span>). Static files placed in
          <span class="inline-code notranslate" translate="no">public/</span> are served at the root URL in dev and copied verbatim into <span class="inline-code notranslate" translate="no">dist/</span>.
        </p>
      </section>

      <section id="wasm-wit">
        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">extension</span>
          WASM Plugin WIT Contract (zerho:plugin@0.1.0)
        </h2>
        <p>
          Third-party plugins execute inside a fuel-metered <span class="inline-code notranslate" translate="no">wasmtime v29</span> sandbox
          (default fuel budget: 1,000,000 instructions) passing UTF-8 strings across linear memory (<span class="inline-code notranslate" translate="no">zerho_alloc</span>,
          <span class="inline-code notranslate" translate="no">zerho_resolve_id</span>, <span class="inline-code notranslate" translate="no">zerho_load</span>,
          <span class="inline-code notranslate" translate="no">zerho_transform</span>). See the complete Rust → <span class="inline-code notranslate" translate="no">.wasm</span>
          reference plugin in <span class="inline-code notranslate" translate="no">examples/wasm-plugin/</span> or inspect this contract anytime via
          <span class="inline-code notranslate" translate="no">zerho wit</span>:
        </p>
        <div class="code-block">
          <div class="code-header">
            <span>zerho-plugin.wit</span>
            <button type="button" class="copy-btn" data-copy={witContract} aria-label="Copy WIT contract">
              <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">content_copy</span>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre class="notranslate" translate="no"><code set:text={witContract} /></pre>
        </div>
      </section>

      <section id="devsecops">
        <h2>
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">verified_user</span>
          Continuous DevSecOps &amp; Supply-Chain Verification
        </h2>
        <p>
          Every commit, pull request, and tagged release of <strong class="notranslate" translate="no">zerho</strong>
          is continuously audited by the <strong class="notranslate" translate="no">GLASTOR® Core</strong>
          security toolchain (<span class="inline-code notranslate" translate="no">.github/workflows/audit.yml</span>
          &amp; <span class="inline-code notranslate" translate="no">.github/workflows/release.yml</span>), with
          every GitHub Action pinned to an immutable 40-character commit SHA:
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Tool</th>
                <th>Role in <span class="notranslate" translate="no">zerho</span> CI/CD</th>
                <th>Artifact / Gate</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><a href="https://specter.glastor.es" target="_blank" rel="noopener noreferrer" class="notranslate" translate="no" style="color: var(--accent-bright);">GLASTOR® Specter</a></td>
                <td>Zero-compiler Rust AST public API contract differ &amp; Trojan Breaking-Change guard across all 9 crates.</td>
                <td>SemVer gate + SARIF 2.1.0 + CycloneDX SBOM</td>
              </tr>
              <tr>
                <td><a href="https://github.com/glastor-core/byte-gauge" target="_blank" rel="noopener noreferrer" class="notranslate" translate="no" style="color: var(--accent-bright);">GLASTOR® Byte-Gauge</a></td>
                <td>SIMD binary hardening auditor on compiled <span class="inline-code notranslate" translate="no">zerho</span> binaries (ASLR/PIE, NX/DEP, Shannon entropy, stripped symbols, &lt; 25 MB budget).</td>
                <td>Release gate + CycloneDX SBOM attached to GitHub Releases</td>
              </tr>
              <tr>
                <td><a href="https://pii-veil.glastor.es" target="_blank" rel="noopener noreferrer" class="notranslate" translate="no" style="color: var(--accent-bright);">GLASTOR® pii-veil</a></td>
                <td>Sub-millisecond Rust DLP engine scanning <span class="inline-code notranslate" translate="no">crates/</span> for accidental PII or secret exposure.</td>
                <td>Continuous DLP telemetry</td>
              </tr>
              <tr>
                <td><a href="https://github.com/glastor-core/nemesis" target="_blank" rel="noopener noreferrer" class="notranslate" translate="no" style="color: var(--accent-bright);">GLASTOR® Nemesis</a></td>
                <td>Universal DevSecOps auditor (Gitleaks secret scan, Semgrep SAST, Trivy SCA, license compliance, repo hygiene).</td>
                <td>Weekly + PR/push SARIF upload to GitHub Security</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
