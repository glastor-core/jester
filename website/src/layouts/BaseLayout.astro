---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Zero-Node, 100% Rust frontend dev server and production bundler shipped as a single 16.60 MB native binary.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://zerho.xyz');
const currentPath = Astro.url.pathname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'zerho',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  softwareVersion: '0.9.0',
  license: 'https://opensource.org/licenses/MIT',
  author: {
    '@type': 'Person',
    name: 'glastor-dev',
    url: 'https://glastor.es/',
  },
  description,
  url: canonicalURL.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="theme-color" content="#090d14" />

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta property="og:image" content={new URL('/images/isologo.webp', canonicalURL).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/images/isologo.webp', canonicalURL).toString()} />

    <!-- Google Fonts: Red Hat Family + Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@600;700;800&family=Red+Hat+Mono:wght@400;500;600;700&family=Red+Hat+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand notranslate" translate="no" aria-label="zerho home">
          <img src="/favicon/favicon.svg" alt="" width="28" height="28" style="border-radius: 6px;" aria-hidden="true" />
          <span>zerho</span>
          <span class="brand-version">v0.9.0</span>
        </a>

        <button
          type="button"
          class="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="primary-nav"
          data-menu-toggle
        >
          <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">menu</span>
        </button>

        <nav id="primary-nav" class="nav-links" aria-label="Primary navigation">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
          <a href="/#benchmarks">Benchmarks</a>
          <a href="/#migrate">Migrate</a>
          <a href="/#architecture">Architecture</a>
          <a href="/docs" aria-current={currentPath.startsWith('/docs') ? 'page' : undefined}>Docs</a>
          <a
            href="https://github.com/glastor-core/jester"
            target="_blank"
            rel="noopener noreferrer"
            class="nav-github notranslate"
            translate="no"
            aria-label="zerho on GitHub"
          >
            <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.09 3.29 9.4 7.86 10.92.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.17 1.18a10.95 10.95 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
            </svg>
            <span>GitHub</span>
          </a>
          <a href="/docs#quick-start" class="nav-cta">
            <span class="material-symbols-outlined notranslate" translate="no" aria-hidden="true">rocket_launch</span>
            <span>Get Started</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong class="notranslate" translate="no" style="color: #ffffff; font-family: var(--font-display);">zerho</strong>
          <span> — Zero-Node, 100% Rust frontend dev server &amp; bundler · Part of the </span>
          <a href="https://glastor.es/" target="_blank" rel="noopener noreferrer" class="notranslate" translate="no" style="color: #f97316; font-weight: 600;">GLASTOR®</a>
          <span> Rust toolchain</span>
        </div>
        <div class="footer-meta notranslate" translate="no">
          <a href="https://github.com/glastor-core/jester" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://pii-veil.glastor.es/" target="_blank" rel="noopener noreferrer">pii-veil</a>
          <a href="https://specter.glastor.es/" target="_blank" rel="noopener noreferrer">specter</a>
          <span>100% Safe Rust</span>
          <span>MIT OR Apache-2.0</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Vanilla micro-interactions: mobile nav + copy-to-clipboard (0 KB framework JS)
      const menuBtn = document.querySelector('[data-menu-toggle]');
      const nav = document.getElementById('primary-nav');
      if (menuBtn && nav) {
        menuBtn.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          menuBtn.setAttribute('aria-expanded', String(open));
        });
        nav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            nav.classList.remove('open');
            menuBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }

      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            btn.setAttribute('data-copied', 'true');
            const label = btn.querySelector('[data-copy-label]');
            const icon = btn.querySelector('.material-symbols-outlined');
            if (label) label.textContent = 'Copied';
            if (icon) icon.textContent = 'check';
            setTimeout(() => {
              btn.removeAttribute('data-copied');
              if (label) label.textContent = 'Copy';
              if (icon) icon.textContent = 'content_copy';
            }, 1800);
          } catch {
            // Clipboard API unavailable in insecure context
          }
        });
      });
    </script>
  </body>
</html>
