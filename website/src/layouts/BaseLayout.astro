---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Zero-Node, 100% Rust frontend dev server and production bundler shipped as a single 16.57 MB native binary.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://zerho.dev');
const currentPath = Astro.url.pathname;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'zerho',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Windows, macOS, Linux',
  softwareVersion: '0.7.0',
  license: 'https://opensource.org/licenses/MIT',
  description,
  url: canonicalURL.toString(),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.toString()} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#090d14" />

    <!-- OpenGraph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Red Hat Family + Material Symbols Outlined -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Red+Hat+Display:wght@600;700;800&family=Red+Hat+Mono:wght@400;500;600;700&family=Red+Hat+Text:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20,400,0,0"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="zerho home">
          <svg width="26" height="26" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#111827" />
            <rect x="2" y="2" width="60" height="60" rx="12" stroke="#f97316" stroke-opacity="0.45" stroke-width="2" />
            <path d="M36.5 10L16 35.5H30.5L27.5 54L48 28.5H33.5L36.5 10Z" fill="#f97316" />
          </svg>
          <span>zerho</span>
          <span class="brand-version">v0.7.0</span>
        </a>

        <button
          type="button"
          class="mobile-menu-btn"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="primary-nav"
          data-menu-toggle
        >
          <span class="material-symbols-outlined" aria-hidden="true">menu</span>
        </button>

        <nav id="primary-nav" class="nav-links" aria-label="Primary navigation">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
          <a href="/#benchmarks">Benchmarks</a>
          <a href="/#architecture">Architecture</a>
          <a href="/docs" aria-current={currentPath.startsWith('/docs') ? 'page' : undefined}>Docs</a>
          <a href="/docs#quick-start" class="nav-cta">
            <span class="material-symbols-outlined" aria-hidden="true">rocket_launch</span>
            <span>Get Started</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <strong style="color: #ffffff; font-family: var(--font-display);">zerho</strong>
          <span> — Zero-Node, 100% Rust frontend dev server &amp; production bundler.</span>
        </div>
        <div class="footer-meta">
          <span>Rust Edition 2024</span>
          <span>unsafe_code = "forbid"</span>
          <span>MIT OR Apache-2.0</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      // Vanilla micro-interactions: mobile nav + copy-to-clipboard (0 KB framework JS)
      const menuBtn = document.querySelector('[data-menu-toggle]');
      const nav = document.getElementById('primary-nav');
      if (menuBtn && nav) {
        menuBtn.addEventListener('click', () => {
          const open = nav.classList.toggle('open');
          menuBtn.setAttribute('aria-expanded', String(open));
        });
      }

      document.querySelectorAll('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy');
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            btn.setAttribute('data-copied', 'true');
            const label = btn.querySelector('[data-copy-label]');
            const icon = btn.querySelector('.material-symbols-outlined');
            if (label) label.textContent = 'Copied';
            if (icon) icon.textContent = 'check';
            setTimeout(() => {
              btn.removeAttribute('data-copied');
              if (label) label.textContent = 'Copy';
              if (icon) icon.textContent = 'content_copy';
            }, 1800);
          } catch {
            // Clipboard API unavailable in insecure context
          }
        });
      });
    </script>
  </body>
</html>
